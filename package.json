{
  "name": "theme_worldcampus",
  "version": "1.0.0",
  "description": "World Campus Moodle Theme with standalone Tailwind CSS styling",
  "main": "index.js",
  "scripts": {
    "build": "npx @tailwindcss/cli -i ./src/css/main.css -o ./style/worldcampus.css --minify",
    "dev": "npx @tailwindcss/cli -i ./src/css/main.css -o ./style/worldcampus.css --watch"
  },
  "keywords": [
    "moodle",
    "theme",
    "worldcampus",
    "tailwind"
  ],
  "author": "Septian Dwi Cahyo",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@tailwindcss/cli": "^4.0.12",
    "tailwindcss": "^4.0.12"
  }
}
