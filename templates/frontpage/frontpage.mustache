{{> theme_worldcampus/head }}
<body {{{ bodyattributes }}}>
    {{{ output.standard_top_of_body_html }}}

    {{> theme_worldcampus/navbar }}

    <main class="flex-1">
        <!-- Hero Section with World Campus Visuals -->
        <section class="relative overflow-hidden pt-12 pb-20 lg:pt-20 lg:pb-32 world-grid-bg">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="text-center max-w-3xl mx-auto space-y-6">
                    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-xs font-semibold tracking-wide">
                        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
                        Next-Gen Distance Learning Ecosystem
                    </div>

                    <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight leading-tight">
                        Empowering Minds <br><span class="world-gradient-text">Across the Globe</span>
                    </h1>

                    <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
                        Experience world-class online learning with interactive digital classrooms, AI-assisted tutoring, and flexible study pathways.
                    </p>

                    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
                        <a href="{{{ herobuttonurl }}}" class="w-full sm:w-auto px-8 py-3.5 rounded-xl world-gradient-primary text-white font-bold text-sm shadow-xl shadow-cyan-500/25 hover:opacity-95 transition-all">
                            {{{ herobuttontext }}}
                        </a>
                        {{^isloggedin}}
                        <a href="{{{ config.wwwroot }}}/login/index.php" class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-slate-900/80 border border-slate-700 text-white font-semibold text-sm hover:bg-slate-800 transition-all">
                            Student Login &rarr;
                        </a>
                        {{/isloggedin}}
                    </div>
                </div>

                <!-- Global Stats Counter Row -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-16 max-w-5xl mx-auto">
                    <div class="glass-card p-6 rounded-2xl text-center border-slate-800/80">
                        <div class="text-3xl sm:text-4xl font-black text-white">12,500+</div>
                        <div class="text-xs text-slate-400 font-semibold uppercase mt-1">Active Students</div>
                    </div>
                    <div class="glass-card p-6 rounded-2xl text-center border-slate-800/80">
                        <div class="text-3xl sm:text-4xl font-black text-cyan-400">45+</div>
                        <div class="text-xs text-slate-400 font-semibold uppercase mt-1">Partner Countries</div>
                    </div>
                    <div class="glass-card p-6 rounded-2xl text-center border-slate-800/80">
                        <div class="text-3xl sm:text-4xl font-black text-indigo-400">180+</div>
                        <div class="text-xs text-slate-400 font-semibold uppercase mt-1">Global Courses</div>
                    </div>
                    <div class="glass-card p-6 rounded-2xl text-center border-slate-800/80">
                        <div class="text-3xl sm:text-4xl font-black text-emerald-400">99.8%</div>
                        <div class="text-xs text-slate-400 font-semibold uppercase mt-1">Satisfaction Rate</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Featured Courses Section -->
        <section class="py-16 bg-slate-950 border-t border-slate-900">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
                    <div>
                        <span class="text-xs font-bold text-cyan-400 uppercase tracking-widest">Academic Catalog</span>
                        <h2 class="text-3xl font-extrabold text-white mt-1">Featured Global Programs</h2>
                    </div>
                    <a href="{{{ config.wwwroot }}}/course/index.php" class="text-sm font-semibold text-cyan-400 hover:text-cyan-300 flex items-center gap-1">
                        View All Programs &rarr;
                    </a>
                </div>

                {{#has_courses}}
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {{#courses}}
                    <div class="glass-card rounded-2xl overflow-hidden border-slate-800/80 hover:border-cyan-500/40 transition-all duration-300 group flex flex-col justify-between">
                        <div class="p-6">
                            <div class="flex items-center justify-between gap-2 mb-3">
                                <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-cyan-500/15 text-cyan-300 border border-cyan-500/20">
                                    Degree Program
                                </span>
                                <span class="text-xs text-slate-400 font-medium">Online &bull; Flexible</span>
                            </div>
                            <h3 class="text-lg font-bold text-white group-hover:text-cyan-300 transition-colors line-clamp-2">
                                {{fullname}}
                            </h3>
                            <p class="text-xs text-slate-400 mt-2 line-clamp-3 leading-relaxed">
                                {{summary}}
                            </p>
                        </div>

                        <div class="p-6 pt-0 border-t border-slate-800/50 mt-4 flex items-center justify-between">
                            <div class="flex items-center gap-2 text-xs text-slate-400">
                                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                                Open Enrollment
                            </div>
                            <a href="{{{ viewurl }}}" class="px-4 py-2 rounded-lg bg-slate-800 hover:bg-cyan-600 text-white text-xs font-bold transition-all">
                                View Course
                            </a>
                        </div>
                    </div>
                    {{/courses}}
                </div>
                {{/has_courses}}
            </div>
        </section>

        <!-- Main Moodle Frontpage Content (Announcements / Site Blocks) -->
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
            {{{ output.main_content }}}
        </div>
    </main>

    {{> theme_worldcampus/footer }}

    {{{ output.standard_end_of_body_html }}}
</body>
</html>
