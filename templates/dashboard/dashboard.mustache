{{> theme_worldcampus/head }}
<body {{{ bodyattributes }}}>
    {{{ output.standard_top_of_body_html }}}

    <!-- Top Navigation -->
    {{> theme_worldcampus/navbar }}

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
        <!-- React 19 + Shadcn UI Dashboard View -->
        <div data-react-mount="DashboardView" data-props="{{{react_props_json}}}"></div>

        <!-- Moodle Dashboard Main Content (Timeline / Blocks) -->
        <div class="pt-6">
            {{{ output.main_content }}}
        </div>
    </main>

    {{> theme_worldcampus/footer }}

    {{{ output.standard_end_of_body_html }}}
</body>
</html>
