{{!
    @template theme_worldcampus/navbar
    This template renders the top navbar with navigation links and user menu.
}}
<nav id="navbar" class="navbar fixed-top navbar-light bg-white border-bottom navbar-expand-lg shadow-sm" aria-label="{{#str}}sitemenubar, admin{{/str}}">
    <div class="container-fluid px-3 px-lg-4">
        {{! Mobile Toggle Button }}
        <button class="navbar-toggler border-0 px-2 py-1 me-2 d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#worldcampusNavbarNav" aria-controls="worldcampusNavbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        {{! Brand Logo }}
        <a href="{{{ config.homeurl }}}" class="navbar-brand d-flex align-items-center m-0 me-4 p-0">
            {{# output.should_display_logo }}
                <img src="{{output.get_logo}}" class="logo logo-light" alt="{{sitename}}" style="max-height: 40px;">
                {{# logodark_url }}
                    <img src="{{logodark_url}}" class="logo logo-dark" alt="{{sitename}}" style="max-height: 40px; display: none;">
                {{/ logodark_url }}
            {{/ output.should_display_logo }}
            {{^ output.should_display_logo }}
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary text-white rounded-3 p-1 px-2 fw-black font-monospace">WC</div>
                    <span class="fw-bold text-dark fs-5">World<span class="text-primary">Campus</span></span>
                </div>
            {{/ output.should_display_logo }}
        </a>

        {{! Main Navigation Links }}
        <div class="collapse navbar-collapse" id="worldcampusNavbarNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0 fw-semibold text-secondary">
                <li class="nav-item">
                    <a class="nav-link px-3 text-dark hover-text-primary" href="{{{ config.homeurl }}}">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-3 text-dark hover-text-primary" href="{{{ config.wwwroot }}}/#about">About Us</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-3 text-dark hover-text-primary" href="{{{ config.wwwroot }}}/#programs">Our Programs</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-3 text-dark hover-text-primary" href="{{{ config.wwwroot }}}/course/index.php">Courses & Microcredentials</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-3 text-dark hover-text-primary" href="{{{ config.wwwroot }}}/#admissions">Admissions</a>
                </li>
                
                {{! If Logged In, show Moodle Primary Menu }}
                {{^is_guest}}
                {{#primarymoremenu}}
                    <li class="nav-item d-none d-xl-block">
                        {{> core/moremenu}}
                    </li>
                {{/primarymoremenu}}
                {{/is_guest}}
            </ul>
        </div>

        {{! Right Side Navigation / Actions }}
        <div id="usernavigation" class="navbar-nav ms-auto d-flex flex-row align-items-center gap-2">
            {{#langmenu}}
                <div class="d-none d-sm-block">
                    {{> theme_worldcampus/language_menu }}
                </div>
                <div class="vr mx-1 d-none d-sm-block" style="height: 24px;"></div>
            {{/langmenu}}

            {{! If Logged In: Popovers & User Menu }}
            {{^is_guest}}
                {{{ output.navbar_plugin_output }}}
                <div class="d-flex align-items-stretch usermenu-container" data-region="usermenu">
                    {{#usermenu}}
                        {{> core/user_menu }}
                    {{/usermenu}}
                </div>
            {{/is_guest}}

            {{! If Guest / Not Logged In: Sign In & Apply Buttons }}
            {{#is_guest}}
                <a href="{{{ config.wwwroot }}}/login/index.php" class="btn btn-outline-primary rounded-pill px-3 py-1.5 fw-semibold small">
                    Sign In
                </a>
                <a href="{{{ config.wwwroot }}}/#admissions" class="btn btn-primary rounded-pill px-3 py-1.5 fw-semibold small shadow-sm d-none d-sm-inline-block">
                    Apply Now
                </a>
            {{/is_guest}}
        </div>
    </div>
</nav>