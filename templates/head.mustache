{{!
    @template theme_worldcampus/head
}}
{{{ output.doctype }}}
<html {{{ output.htmlattributes }}} {{#themepreference}}data-theme="{{.}}"{{/themepreference}}>
<head>
    <script>
        (function() {
            const getSavedTheme = () => {
                let theme = 'light';
                try {
                    theme = localStorage.getItem('worldcampus_theme_preference');
                    if (theme) return theme;
                } catch (e) {}
                
                const cookies = document.cookie.split(';');
                for (let i = 0; i < cookies.length; i++) {
                    let c = cookies[i].trim();
                    if (c.indexOf('worldcampus_theme_preference=') === 0) {
                        return c.substring('worldcampus_theme_preference='.length, c.length);
                    }
                }
                return 'light';
            };
            const applyTheme = () => {
                const theme = getSavedTheme();
                const isDark = theme === 'dark' || (theme === 'auto' && (window.matchMedia('(prefers-color-scheme: dark)').matches || document.documentElement.getAttribute('data-bs-theme') === 'dark'));
                if (isDark) {
                    document.documentElement.setAttribute('data-theme', 'dark');
                } else {
                    document.documentElement.removeAttribute('data-theme');
                }
            };
            applyTheme();
            
            const observer = new MutationObserver((mutations) => {
                mutations.forEach((mutation) => {
                    if (mutation.type === 'attributes' && (mutation.attributeName === 'data-theme' || mutation.attributeName === 'data-bs-theme')) {
                        const theme = getSavedTheme();
                        if (theme === 'auto') return;
                        
                        const isDark = theme === 'dark';
                        const hasAttr = document.documentElement.hasAttribute('data-theme');
                        if (isDark && !hasAttr) {
                            document.documentElement.setAttribute('data-theme', 'dark');
                        } else if (!isDark && hasAttr) {
                            document.documentElement.removeAttribute('data-theme');
                        }
                    }
                });
            });
            observer.observe(document.documentElement, { attributes: true });
        })();
    </script>
    <title>{{{ output.page_title }}}</title>
    <link rel="shortcut icon" href="{{{ output.favicon }}}" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&family=DM+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="{{{ config.wwwroot }}}/theme/worldcampus/style/worldcampus.css">
    {{{ output.standard_head_html }}}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
