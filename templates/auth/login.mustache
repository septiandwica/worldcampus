{{> theme_worldcampus/head }}
<body {{{ bodyattributes }}}>
    {{{ output.standard_top_of_body_html }}}

    <div class="min-h-screen flex flex-col lg:flex-row world-grid-bg">
        <!-- Left Hero & Global Campus Telemetry (pjj_world aesthetic) -->
        <div class="hidden lg:flex lg:w-1/2 relative flex-col justify-between p-12 overflow-hidden border-r border-slate-800/60">
            <!-- Background Glows -->
            <div class="absolute -top-32 -left-32 w-96 h-96 bg-cyan-500/20 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-indigo-500/20 rounded-full blur-3xl pointer-events-none"></div>

            <!-- Brand Header -->
            <div class="relative z-10">
                <a href="{{{ config.wwwroot }}}" class="flex items-center gap-3">
                    <div class="w-12 h-12 rounded-2xl world-gradient-primary flex items-center justify-center shadow-xl shadow-cyan-500/20">
                        <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <div>
                        <span class="text-2xl font-black tracking-tight text-white">World<span class="world-gradient-text">Campus</span></span>
                        <p class="text-xs text-slate-400 font-medium">President Digital Learning Ecosystem</p>
                    </div>
                </a>
            </div>

            <!-- Central Visual & Telemetry Card -->
            <div class="relative z-10 my-auto space-y-6">
                <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 text-xs font-semibold">
                    <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
                    Global Distance Learning Platform
                </div>

                <h1 class="text-4xl xl:text-5xl font-extrabold text-white tracking-tight leading-tight">
                    Your Gateway to <br><span class="world-gradient-text">World-Class Education</span>
                </h1>

                <p class="text-slate-300 text-base max-w-lg leading-relaxed">
                    Access interactive courses, collaborate with international cohorts, and accelerate your mastery with real-time AI learning support.
                </p>

                <!-- Mini Telemetry Badges -->
                <div class="grid grid-cols-3 gap-4 pt-4 max-w-lg">
                    <div class="glass-card p-4 rounded-xl text-center">
                        <div class="text-xl font-extrabold text-white">45+</div>
                        <div class="text-[11px] text-slate-400 font-medium uppercase mt-0.5">Countries</div>
                    </div>
                    <div class="glass-card p-4 rounded-xl text-center">
                        <div class="text-xl font-extrabold text-cyan-400">100%</div>
                        <div class="text-[11px] text-slate-400 font-medium uppercase mt-0.5">Digital Sync</div>
                    </div>
                    <div class="glass-card p-4 rounded-xl text-center">
                        <div class="text-xl font-extrabold text-indigo-400">24/7</div>
                        <div class="text-[11px] text-slate-400 font-medium uppercase mt-0.5">AI Tutor</div>
                    </div>
                </div>
            </div>

            <!-- Footer Note -->
            <div class="relative z-10 text-xs text-slate-500">
                &copy; 2026 World Campus &bull; President University Distance Learning.
            </div>
        </div>

        <!-- Right Login Form Panel -->
        <div class="w-full lg:w-1/2 flex items-center justify-center p-6 sm:p-12">
            <div class="max-w-md w-full glass-card p-8 sm:p-10 rounded-2xl shadow-2xl border border-slate-800/80">
                <!-- Mobile Logo Header -->
                <div class="lg:hidden flex items-center gap-3 mb-8">
                    <div class="w-10 h-10 rounded-xl world-gradient-primary flex items-center justify-center">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <div>
                        <span class="text-xl font-bold text-white">World<span class="world-gradient-text">Campus</span></span>
                    </div>
                </div>

                <div class="mb-6">
                    <h2 class="text-2xl font-bold text-white">Sign In to Your Account</h2>
                    <p class="text-sm text-slate-400 mt-1">Enter your credentials to continue to the learning portal</p>
                </div>

                <!-- President SSO Shortcut Button -->
                <div class="mb-6">
                    <a href="{{{ sso_url }}}" class="w-full py-3 px-4 rounded-xl world-gradient-accent text-white font-semibold text-sm flex items-center justify-center gap-3 hover:opacity-95 transition-all shadow-lg shadow-cyan-500/20">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path></svg>
                        Sign in with University SSO
                    </a>
                </div>

                <div class="relative flex py-2 items-center mb-6">
                    <div class="flex-grow border-t border-slate-800"></div>
                    <span class="flex-shrink mx-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">or direct sign in</span>
                    <div class="flex-grow border-t border-slate-800"></div>
                </div>

                <!-- Native Moodle Login Form Content Container -->
                <div class="space-y-4">
                    {{{ output.main_content }}}
                </div>

                <div class="mt-8 pt-6 border-t border-slate-800/80 text-center">
                    <p class="text-xs text-slate-400">
                        Need assistance? <a href="#" class="text-cyan-400 hover:underline font-medium">Contact Digital Campus Helpdesk</a>
                    </p>
                </div>
            </div>
        </div>
    </div>

    {{{ output.standard_end_of_body_html }}}
</body>
</html>
