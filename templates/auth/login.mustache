{{> theme_worldcampus/head }}
<body {{{ bodyattributes }}}>
    {{{ output.standard_top_of_body_html }}}

    <!-- React 19 + Shadcn UI Auth Screen -->
    <div data-react-mount="AuthScreen" data-props="{{{react_props_json}}}"></div>

    <!-- Hidden Container for Native Moodle Login Form Injection -->
    <div id="moodle-raw-content" class="hidden">
        {{{ output.main_content }}}
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const rawContent = document.getElementById('moodle-raw-content');
            const targetContainer = document.getElementById('moodle-native-login-container');
            if (rawContent && targetContainer) {
                targetContainer.innerHTML = rawContent.innerHTML;
            }
        });
    </script>

    {{{ output.standard_end_of_body_html }}}
</body>
</html>
