<div class="usermenu">
    {{#unauthenticateduser}}
        <div class="flex items-center gap-2">
            {{#guest}}
                <span class="text-xs text-slate-400 font-semibold">{{#str}} loggedinasguest, core {{/str}}</span>
                <a href="{{{config.wwwroot}}}/login/logout.php?sesskey={{{config.sesskey}}}" class="px-3 py-1.5 rounded-lg border border-rose-500/30 text-rose-400 text-xs font-semibold hover:bg-rose-500/10 transition-all">
                    {{#str}} logout, core {{/str}}
                </a>
            {{/guest}}
            {{#url}}
                <a href="{{url}}" class="px-4 py-1.5 rounded-xl world-gradient-primary text-white text-xs font-bold shadow-md shadow-cyan-500/20 hover:opacity-95 transition-all">
                    {{#str}} login, core {{/str}}
                </a>
            {{/url}}
        </div>
    {{/unauthenticateduser}}

    {{^unauthenticateduser}}
        <div class="relative dropdown">
            <button type="button" class="flex items-center gap-2 p-1.5 rounded-xl hover:bg-slate-800/40 transition-all focus:outline-none" id="user-menu-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <div class="w-8 h-8 rounded-xl world-gradient-accent flex items-center justify-center text-white font-bold text-xs shadow-md shadow-cyan-500/20 overflow-hidden">
                    {{#avatardata}}
                        {{{content}}}
                    {{/avatardata}}
                    {{^avatardata}}
                        <span>U</span>
                    {{/avatardata}}
                </div>
                <div class="hidden lg:flex flex-col text-left">
                    <span class="text-xs font-bold text-slate-200 leading-tight">{{userfullname}}</span>
                    <span class="text-[10px] text-cyan-400 font-medium">Student / Member</span>
                </div>
                <svg class="w-3.5 h-3.5 text-slate-400 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>

            <!-- Dropdown Menu -->
            <div id="user-action-menu" class="dropdown-menu dropdown-menu-right">
                <div class="px-3 py-2 border-b border-slate-700/40 mb-1">
                    <div class="text-xs font-bold text-slate-200">{{userfullname}}</div>
                </div>

                {{> core/user_action_menu_items }}

                {{#submenus}}
                    <div class="border-t border-slate-700/40 my-1"></div>
                    <div class="px-3 py-1 text-[11px] font-bold text-slate-400 uppercase tracking-wider">{{title}}</div>
                    {{> core/user_action_menu_submenu_items }}
                {{/submenus}}
            </div>
        </div>
    {{/unauthenticateduser}}
</div>
