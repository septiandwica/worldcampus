{{> theme_worldcampus/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}

<div id="page-wrapper" class="d-print-block">
    {{{ output.standard_top_of_body_html }}}

    {{> theme_worldcampus/navbar }}

    <div id="page" data-region="mainpage" class="worldcampus-marketplace-page bg-light">

        {{! ========================================== }}
        {{! LOGGED-IN USER RESUME COURSES BANNER       }}
        {{! ========================================== }}
        {{#isloggedin}}
        {{#has_resume_courses}}
        <section class="py-4 bg-white border-bottom shadow-sm">
            <div class="container">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div>
                        <h4 class="fw-bold mb-1 text-dark">Welcome back, {{user_firstname}}! 👋</h4>
                        <p class="text-muted small mb-0">Pick up where you left off and keep moving forward.</p>
                    </div>
                    <a href="{{dashboard_url}}" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                        Go to My Dashboard <i class="fa fa-arrow-right ms-1"></i>
                    </a>
                </div>
                <div class="row g-3">
                    {{#resume_courses}}
                    <div class="col-12 col-md-4">
                        <div class="card h-100 border rounded-3 shadow-none hover-shadow transition">
                            <div class="row g-0 align-items-center h-100">
                                <div class="col-4">
                                    <img src="{{image}}" class="img-fluid rounded-start h-100 object-fit-cover" style="min-height: 90px;" alt="{{fullname}}">
                                </div>
                                <div class="col-8">
                                    <div class="card-body p-3">
                                        <h6 class="card-title fw-bold text-dark text-truncate mb-1" title="{{fullname}}">{{fullname}}</h6>
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <span class="text-muted small">Progress</span>
                                            <span class="text-primary fw-bold small">{{progress}}%</span>
                                        </div>
                                        <div class="progress" style="height: 6px;">
                                            <div class="progress-bar bg-primary" role="progressbar" style="width: {{progress}}%;" aria-valuenow="{{progress}}" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                        <a href="{{url}}" class="stretched-link"></a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    {{/resume_courses}}
                </div>
            </div>
        </section>
        {{/has_resume_courses}}
        {{/isloggedin}}

        {{! ========================================== }}
        {{! COURSERA-STYLE HERO SECTION                }}
        {{! ========================================== }}
        <section class="hero-marketplace py-5 py-lg-6 position-relative overflow-hidden bg-white border-bottom">
            <div class="container position-relative z-1">
                <div class="row align-items-center gy-5">
                    <div class="col-12 col-lg-7 text-center text-lg-start">
                        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-primary-subtle text-primary fw-semibold small mb-3">
                            <span class="badge bg-primary text-white rounded-pill px-2">NEW</span>
                            <span>Global Online Degree & Certificate Marketplace</span>
                        </div>
                        <h1 class="display-4 fw-black text-dark tracking-tight mb-3">
                            Learn Without <span class="text-primary text-gradient-primary">Limits</span>
                        </h1>
                        <p class="lead text-secondary mb-4 col-lg-11 px-0">
                            Build real-world skills with interactive online courses, professional certifications, and accredited degrees from top university faculty and industry experts.
                        </p>

                        {{! Coursera-style Search Box }}
                        <div class="marketplace-search-box p-2 bg-white rounded-pill shadow-lg border mb-3 max-w-xl">
                            <form action="{{search_url}}" method="get" class="d-flex align-items-center w-100">
                                <div class="input-group">
                                    <span class="input-group-text bg-transparent border-0 ps-3 text-muted">
                                        <i class="fa fa-search"></i>
                                    </span>
                                    <input type="text" name="search" class="form-control border-0 shadow-none ps-2" placeholder="What do you want to learn? (e.g. Python, AI, Business, Cloud)" aria-label="Course Search">
                                    <button class="btn btn-primary rounded-pill px-4 fw-semibold" type="submit">
                                        Explore Courses
                                    </button>
                                </div>
                            </form>
                        </div>

                        {{! Popular Topics Quick Pills }}
                        <div class="d-flex flex-wrap align-items-center gap-2 text-muted small">
                            <span class="fw-semibold text-dark">Popular:</span>
                            <a href="{{search_url}}?search=Python" class="badge rounded-pill bg-light text-dark border text-decoration-none px-3 py-2 hover-bg-primary">Python</a>
                            <a href="{{search_url}}?search=AI" class="badge rounded-pill bg-light text-dark border text-decoration-none px-3 py-2 hover-bg-primary">AI & Machine Learning</a>
                            <a href="{{search_url}}?search=Data" class="badge rounded-pill bg-light text-dark border text-decoration-none px-3 py-2 hover-bg-primary">Data Science</a>
                            <a href="{{search_url}}?search=Business" class="badge rounded-pill bg-light text-dark border text-decoration-none px-3 py-2 hover-bg-primary">Business Management</a>
                        </div>
                    </div>

                    {{! Hero Visual Card Stack }}
                    <div class="col-12 col-lg-5">
                        <div class="hero-visual-card position-relative p-4 rounded-4 shadow-2xl bg-gradient-navy text-white border border-light-subtle">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <span class="badge bg-danger rounded-pill px-3 py-1 fw-bold">FEATURED SPECIALIZATION</span>
                                <span class="text-white-50 small"><i class="fa fa-globe me-1"></i> Global Campus</span>
                            </div>
                            <h4 class="fw-bold text-white mb-2">Applied AI & Cloud Engineering</h4>
                            <p class="text-white-50 small mb-3">Master modern full-stack intelligent applications, LLM orchestration, and cloud infrastructure.</p>
                            
                            <div class="d-flex align-items-center gap-2 mb-4">
                                <div class="text-warning small">
                                    <i class="fa fa-star"></i>
                                    <i class="fa fa-star"></i>
                                    <i class="fa fa-star"></i>
                                    <i class="fa fa-star"></i>
                                    <i class="fa fa-star-half-o"></i>
                                </div>
                                <span class="fw-bold text-white small">4.9</span>
                                <span class="text-white-50 small">(4,280 reviews)</span>
                            </div>

                            <div class="p-3 bg-white-10 rounded-3 mb-4 backdrop-blur">
                                <div class="row text-center text-white g-2">
                                    <div class="col-4 border-end border-white-20">
                                        <div class="fw-bold h5 mb-0 text-white">100%</div>
                                        <div class="small text-white-50" style="font-size: 0.75rem;">Online</div>
                                    </div>
                                    <div class="col-4 border-end border-white-20">
                                        <div class="fw-bold h5 mb-0 text-white">4 Mos</div>
                                        <div class="small text-white-50" style="font-size: 0.75rem;">Self-Paced</div>
                                    </div>
                                    <div class="col-4">
                                        <div class="fw-bold h5 mb-0 text-white">Certificate</div>
                                        <div class="small text-white-50" style="font-size: 0.75rem;">Shareable</div>
                                    </div>
                                </div>
                            </div>

                            <a href="{{catalog_url}}" class="btn btn-light text-primary w-100 rounded-pill fw-bold py-2 shadow-sm">
                                View Course Catalog <i class="fa fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {{! ========================================== }}
        {{! TRUSTED PARTNERS & INSTITUTIONS TICKER     }}
        {{! ========================================== }}
        <section class="py-4 bg-white border-bottom">
            <div class="container text-center">
                <p class="text-uppercase text-muted fw-bold small tracking-wider mb-3">
                    Collaborating with leading universities and global industry organizations
                </p>
                <div class="row align-items-center justify-content-center g-4 opacity-75">
                    <div class="col-6 col-md-2 col-lg-2 fw-bold text-secondary">
                        <i class="fa fa-university me-1"></i> PresUniv
                    </div>
                    <div class="col-6 col-md-2 col-lg-2 fw-bold text-secondary">
                        <i class="fa fa-graduation-cap me-1"></i> Global Institute
                    </div>
                    <div class="col-6 col-md-2 col-lg-2 fw-bold text-secondary">
                        <i class="fa fa-cloud me-1"></i> Cloud Academy
                    </div>
                    <div class="col-6 col-md-2 col-lg-2 fw-bold text-secondary">
                        <i class="fa fa-code me-1"></i> AI Consortium
                    </div>
                    <div class="col-6 col-md-2 col-lg-2 fw-bold text-secondary">
                        <i class="fa fa-briefcase me-1"></i> Tech Ventures
                    </div>
                </div>
            </div>
        </section>

        {{! ========================================== }}
        {{! EXPLORE BY CATEGORIES                      }}
        {{! ========================================== }}
        {{#has_categories}}
        <section class="py-5 bg-light border-bottom">
            <div class="container">
                <div class="d-flex flex-column flex-md-row align-items-md-end justify-content-between mb-4">
                    <div>
                        <span class="text-primary fw-bold text-uppercase small tracking-wider">Top Disciplines</span>
                        <h2 class="fw-bold text-dark mb-1">Explore Top Categories</h2>
                        <p class="text-muted mb-0">Browse accredited fields of study and specialized skills.</p>
                    </div>
                    <a href="{{catalog_url}}" class="btn btn-link text-primary fw-bold text-decoration-none px-0 mt-2 mt-md-0">
                        All Categories <i class="fa fa-angle-right ms-1"></i>
                    </a>
                </div>

                <div class="row g-3">
                    {{#categories}}
                    <div class="col-6 col-md-4 col-lg-3">
                        <a href="{{url}}" class="card h-100 border rounded-3 p-3 bg-white text-decoration-none text-dark hover-lift shadow-sm transition">
                            <div class="d-flex align-items-center gap-3">
                                <div class="category-icon-box bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                                    <i class="fa fa-book fa-lg"></i>
                                </div>
                                <div class="overflow-hidden">
                                    <h6 class="fw-bold mb-0 text-truncate">{{name}}</h6>
                                    <small class="text-muted">{{count}} Courses</small>
                                </div>
                            </div>
                        </a>
                    </div>
                    {{/categories}}
                </div>
            </div>
        </section>
        {{/has_categories}}

        {{! ========================================== }}
        {{! COURSERA-STYLE COURSE MARKETPLACE GRID     }}
        {{! ========================================== }}
        {{#has_marketplace_courses}}
        <section class="py-5 bg-white border-bottom">
            <div class="container">
                <div class="d-flex flex-column flex-md-row align-items-md-end justify-content-between mb-4">
                    <div>
                        <span class="text-primary fw-bold text-uppercase small tracking-wider">Featured Learning</span>
                        <h2 class="fw-bold text-dark mb-1">Most Popular Courses & Certifications</h2>
                        <p class="text-muted mb-0">Highest rated courses chosen by thousands of global learners this semester.</p>
                    </div>
                    <a href="{{catalog_url}}" class="btn btn-outline-primary rounded-pill px-4 fw-semibold mt-3 mt-md-0">
                        Browse All Courses
                    </a>
                </div>

                <div class="row g-4">
                    {{#marketplace_courses}}
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="card h-100 border rounded-3 overflow-hidden shadow-sm coursera-course-card transition">
                            {{! Card Image with Category Tag }}
                            <div class="position-relative overflow-hidden" style="height: 160px;">
                                <img src="{{image}}" class="card-img-top w-100 h-100 object-fit-cover" alt="{{fullname}}">
                                <div class="position-absolute top-0 start-0 m-2">
                                    <span class="badge bg-dark bg-opacity-75 rounded-pill px-2 py-1 text-white font-monospace small" style="font-size: 0.7rem;">
                                        {{category}}
                                    </span>
                                </div>
                            </div>

                            {{! Card Body }}
                            <div class="card-body p-3 d-flex flex-column">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <div class="partner-avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 22px; height: 22px; font-size: 0.65rem;">
                                        WC
                                    </div>
                                    <span class="text-muted small fw-semibold text-truncate">{{instructor}}</span>
                                </div>

                                <h6 class="card-title fw-bold text-dark line-clamp-2 mb-2" style="min-height: 2.6rem;" title="{{fullname}}">
                                    <a href="{{url}}" class="text-dark text-decoration-none hover-text-primary">{{fullname}}</a>
                                </h6>

                                <p class="card-text text-muted small line-clamp-2 mb-3 flex-grow-1">
                                    {{summary}}
                                </p>

                                <div class="d-flex align-items-center gap-1 text-warning small mb-2">
                                    <i class="fa fa-star"></i>
                                    <span class="fw-bold text-dark ms-1">{{rating}}</span>
                                    <span class="text-muted ms-1">({{rating_count}})</span>
                                </div>

                                <div class="pt-2 border-top d-flex align-items-center justify-content-between">
                                    <span class="badge bg-light text-secondary border rounded-pill px-2 py-1 small" style="font-size: 0.72rem;">
                                        {{level}}
                                    </span>
                                    <a href="{{url}}" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold">
                                        Enroll Now
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    {{/marketplace_courses}}
                </div>
            </div>
        </section>
        {{/has_marketplace_courses}}

        {{! ========================================== }}
        {{! VALUE PROPOSITIONS / WHY WORLD CAMPUS      }}
        {{! ========================================== }}
        <section class="py-5 bg-light border-bottom">
            <div class="container text-center max-w-4xl mx-auto mb-5">
                <span class="text-primary fw-bold text-uppercase small tracking-wider">World-Class Excellence</span>
                <h2 class="display-6 fw-bold text-dark mb-2">Why Learn on World Campus?</h2>
                <p class="lead text-muted">We provide an end-to-end digital university experience built for career transformation and lifelong success.</p>
            </div>

            <div class="container">
                <div class="row g-4">
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center bg-white">
                            <div class="mx-auto mb-3 bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                <i class="fa fa-certificate fa-2x"></i>
                            </div>
                            <h5 class="fw-bold text-dark mb-2">Accredited Credentials</h5>
                            <p class="text-muted small mb-0">Earn official digital certificates and degree credits recognized by top international employers.</p>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center bg-white">
                            <div class="mx-auto mb-3 bg-success-subtle text-success rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                <i class="fa fa-laptop fa-2x"></i>
                            </div>
                            <h5 class="fw-bold text-dark mb-2">Hands-on Projects</h5>
                            <p class="text-muted small mb-0">Apply theoretical knowledge directly to industry-standard capstone projects and portfolios.</p>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center bg-white">
                            <div class="mx-auto mb-3 bg-warning-subtle text-warning rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                <i class="fa fa-bolt fa-2x"></i>
                            </div>
                            <h5 class="fw-bold text-dark mb-2">AI-Powered Tutor</h5>
                            <p class="text-muted small mb-0">Get 24/7 instant guidance, code reviews, and concept explanations with Demi AI tutor integration.</p>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center bg-white">
                            <div class="mx-auto mb-3 bg-info-subtle text-info rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                <i class="fa fa-clock-o fa-2x"></i>
                            </div>
                            <h5 class="fw-bold text-dark mb-2">100% Flexible</h5>
                            <p class="text-muted small mb-0">Learn on your own schedule across mobile, tablet, and desktop with lifetime course access.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {{! ========================================== }}
        {{! ENTERPRISE / UPGRADE CALLOUT BANNER        }}
        {{! ========================================== }}
        <section class="py-5 bg-gradient-navy text-white">
            <div class="container">
                <div class="row align-items-center gy-4">
                    <div class="col-12 col-lg-8 text-center text-lg-start">
                        <span class="badge bg-danger rounded-pill px-3 py-1 fw-bold mb-2">FOR ORGANIZATIONS & TEAMS</span>
                        <h2 class="display-6 fw-black text-white mb-2">Upskill Your Workforce with World Campus Enterprise</h2>
                        <p class="text-white-50 lead mb-0">Provide your team with on-demand access to 100+ global courses, analytics dashboards, and custom certification tracks.</p>
                    </div>
                    <div class="col-12 col-lg-4 text-center text-lg-end">
                        <a href="{{catalog_url}}" class="btn btn-light text-primary btn-lg rounded-pill fw-bold px-4 shadow">
                            Contact Enterprise Team
                        </a>
                    </div>
                </div>
            </div>
        </section>

        {{! ========================================== }}
        {{! MOODLE STANDARD CONTENT & BLOCKS REGION    }}
        {{! ========================================== }}
        {{#hasblocks}}
        <section class="py-4 bg-white border-top">
            <div class="container">
                <div id="region-main-box">
                    <section id="region-main" aria-label="{{#str}}content{{/str}}">
                        {{{ output.main_content }}}
                    </section>
                </div>
            </div>
        </section>
        {{/hasblocks}}

    </div>

    {{> theme_worldcampus/footer }}
</div>

{{{ output.standard_after_main_region_html }}}
{{{ output.standard_end_of_body_html }}}
</body>
</html>
