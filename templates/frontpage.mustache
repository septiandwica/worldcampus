{{> theme_worldcampus/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}

<div id="page-wrapper" class="d-print-block">
    {{{ output.standard_top_of_body_html }}}

    {{> theme_worldcampus/navbar }}

    <div id="page" data-region="mainpage" class="worldcampus-landing-page bg-light">

        {{! ========================================== }}
        {{! 1. HERO SECTION (Clean & Lightweight)     }}
        {{! ========================================== }}
        <section class="hero-section py-5 py-lg-6 bg-white border-bottom position-relative">
            <div class="container py-3">
                <div class="row align-items-center gy-5">
                    <div class="col-12 col-lg-7 text-center text-lg-start">
                        <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill bg-primary-subtle text-primary fw-semibold small mb-3">
                            <span class="badge bg-primary text-white rounded-pill px-2 py-1">2026/2027</span>
                            <span>Global Online Degree & Microcredentials Intake Open</span>
                        </div>
                        <h1 class="display-4 fw-black text-dark tracking-tight mb-3">
                            Learn Without Limits with <span class="text-primary text-gradient-primary">World Campus</span>
                        </h1>
                        <p class="lead text-secondary mb-4 col-lg-11 px-0">
                            Empowering future-ready leaders with globally accredited distance learning (PJJ), flexible university degrees, and industry-demanded microcredentials.
                        </p>

                        <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-lg-start gap-3 mb-4">
                            <a href="#programs" class="btn btn-primary btn-lg rounded-pill px-4 fw-bold shadow-sm">
                                Explore Our Programs <i class="fa fa-arrow-down ms-1"></i>
                            </a>
                            <a href="#about" class="btn btn-outline-secondary btn-lg rounded-pill px-4 fw-bold">
                                About Us
                            </a>
                        </div>

                        {{! Key Trust Badges }}
                        <div class="row g-3 pt-3 border-top text-start">
                            <div class="col-4">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fa fa-check-circle text-primary"></i>
                                    <span class="small fw-semibold text-dark">100% Online</span>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fa fa-certificate text-primary"></i>
                                    <span class="small fw-semibold text-dark">Accredited Degrees</span>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fa fa-bolt text-primary"></i>
                                    <span class="small fw-semibold text-dark">AI Tutor Powered</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    {{! Hero Visual Card Showcase }}
                    <div class="col-12 col-lg-5">
                        <div class="hero-visual-card p-4 rounded-4 shadow-xl bg-gradient-navy text-white border border-light-subtle">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <span class="badge bg-danger rounded-pill px-3 py-1 fw-bold">ONLINE DEGREE & CERTIFICATIONS</span>
                                <span class="text-white-50 small"><i class="fa fa-globe me-1"></i> Global Reach</span>
                            </div>
                            <h4 class="fw-bold text-white mb-2">Distance Learning (PJJ) & Microcredentials</h4>
                            <p class="text-white-50 small mb-3">Designed specifically for working professionals, high-achieving high school graduates, and lifelong learners.</p>

                            <ul class="list-unstyled space-y-2 text-white small mb-4">
                                <li class="d-flex align-items-center gap-2 mb-2">
                                    <i class="fa fa-graduation-cap text-warning"></i> S1 Bachelor Degrees (PJJ Computer Science, Business)
                                </li>
                                <li class="d-flex align-items-center gap-2 mb-2">
                                    <i class="fa fa-briefcase text-info"></i> S2 Masters Program (Master of Management PJJ)
                                </li>
                                <li class="d-flex align-items-center gap-2 mb-2">
                                    <i class="fa fa-code text-success"></i> Short Microcredentials (AI, Cloud, Fullstack)
                                </li>
                            </ul>

                            <a href="#programs" class="btn btn-light text-primary w-100 rounded-pill fw-bold py-2 shadow-sm">
                                View Full Program Catalog <i class="fa fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {{! ========================================== }}
        {{! 2. OUR PROGRAMS SECTION (#programs)        }}
        {{! ========================================== }}
        <section id="programs" class="py-5 bg-light border-bottom">
            <div class="container py-3">
                <div class="text-center max-w-3xl mx-auto mb-5">
                    <span class="text-primary fw-bold text-uppercase small tracking-wider">Academic Offerings</span>
                    <h2 class="display-6 fw-bold text-dark mb-2">Our Programs & Pathways</h2>
                    <p class="lead text-muted">Choose the learning pathway that matches your career goals and lifestyle.</p>
                </div>

                <div class="row g-4">
                    {{! Program 1: S1 Bachelor Degrees }}
                    <div class="col-12 col-md-4">
                        <div class="card h-100 border rounded-4 p-4 bg-white shadow-sm hover-lift transition">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div class="bg-primary-subtle text-primary rounded-3 p-3">
                                    <i class="fa fa-graduation-cap fa-2x"></i>
                                </div>
                                <span class="badge bg-primary rounded-pill px-3 py-1">S1 / Bachelor</span>
                            </div>
                            <h4 class="fw-bold text-dark mb-2">Undergraduate Degrees (PJJ)</h4>
                            <p class="text-muted small mb-3">Comprehensive 4-year equivalent bachelor degree programs delivered 100% online with interactive live sessions.</p>
                            
                            <h6 class="fw-bold text-dark small text-uppercase tracking-wider mb-2">Available Majors:</h6>
                            <ul class="text-muted small ps-3 mb-4 space-y-1">
                                <li>Informatics / Computer Science (PJJ)</li>
                                <li>Information Systems (PJJ)</li>
                                <li>Business Administration (PJJ)</li>
                                <li>Accounting & Finance (PJJ)</li>
                            </ul>

                            <div class="mt-auto pt-3 border-top d-flex align-items-center justify-content-between">
                                <span class="small text-muted"><i class="fa fa-clock-o me-1"></i> Flexible Schedule</span>
                                <a href="{{catalog_url}}" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold">Learn More</a>
                            </div>
                        </div>
                    </div>

                    {{! Program 2: S2 Postgraduate Degrees }}
                    <div class="col-12 col-md-4">
                        <div class="card h-100 border rounded-4 p-4 bg-white shadow-sm hover-lift transition">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div class="bg-info-subtle text-info rounded-3 p-3">
                                    <i class="fa fa-university fa-2x"></i>
                                </div>
                                <span class="badge bg-info rounded-pill px-3 py-1 text-white">S2 / Masters</span>
                            </div>
                            <h4 class="fw-bold text-dark mb-2">Postgraduate Degrees</h4>
                            <p class="text-muted small mb-3">Executive master's degree programs designed for working professionals seeking managerial advancement.</p>
                            
                            <h6 class="fw-bold text-dark small text-uppercase tracking-wider mb-2">Available Majors:</h6>
                            <ul class="text-muted small ps-3 mb-4 space-y-1">
                                <li>Master of Management (MM Online)</li>
                                <li>Master of Information Technology (MIT)</li>
                                <li>Strategic Leadership & Innovation</li>
                            </ul>

                            <div class="mt-auto pt-3 border-top d-flex align-items-center justify-content-between">
                                <span class="small text-muted"><i class="fa fa-calendar me-1"></i> 1.5 - 2 Years</span>
                                <a href="{{catalog_url}}" class="btn btn-sm btn-outline-info rounded-pill px-3 fw-semibold">Learn More</a>
                            </div>
                        </div>
                    </div>

                    {{! Program 3: Microcredentials & Certificates }}
                    <div class="col-12 col-md-4">
                        <div class="card h-100 border rounded-4 p-4 bg-white shadow-sm hover-lift transition border-primary-subtle">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div class="bg-success-subtle text-success rounded-3 p-3">
                                    <i class="fa fa-certificate fa-2x"></i>
                                </div>
                                <span class="badge bg-success rounded-pill px-3 py-1">Microcredentials</span>
                            </div>
                            <h4 class="fw-bold text-dark mb-2">Short Professional Tracks</h4>
                            <p class="text-muted small mb-3">Intensive, skill-based bootcamps and digital certificates to master cutting-edge tech and business domains.</p>
                            
                            <h6 class="fw-bold text-dark small text-uppercase tracking-wider mb-2">Popular Tracks:</h6>
                            <ul class="text-muted small ps-3 mb-4 space-y-1">
                                <li>Applied Generative AI & Machine Learning</li>
                                <li>Cloud Solutions & DevOps Engineering</li>
                                <li>Fullstack Web & Mobile Development</li>
                                <li>Digital Marketing & Growth Hacking</li>
                            </ul>

                            <div class="mt-auto pt-3 border-top d-flex align-items-center justify-content-between">
                                <span class="small text-muted"><i class="fa fa-bolt me-1"></i> 8 - 12 Weeks</span>
                                <a href="{{catalog_url}}" class="btn btn-sm btn-success text-white rounded-pill px-3 fw-semibold">Explore Tracks</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {{! ========================================== }}
        {{! 3. ABOUT US SECTION (#about)               }}
        {{! ========================================== }}
        <section id="about" class="py-5 bg-white border-bottom">
            <div class="container py-3">
                <div class="row align-items-center gy-5">
                    <div class="col-12 col-lg-6">
                        <span class="text-primary fw-bold text-uppercase small tracking-wider">About World Campus</span>
                        <h2 class="display-6 fw-bold text-dark mb-3">Pioneering Digital Higher Education in Indonesia & Beyond</h2>
                        <p class="text-secondary mb-3">
                            World Campus is the digital arm of President University dedicated to delivering world-class Distance Learning (Pendidikan Jarak Jauh / PJJ). We break geographical boundaries by offering high-quality, industry-aligned university education to students and professionals across 45+ countries.
                        </p>
                        <p class="text-secondary mb-4">
                            With asynchronous digital classrooms, live interactive mentorship from international faculty, and 24/7 AI learning assistance, we ensure every student achieves academic excellence without compromising their professional careers.
                        </p>
                        
                        <div class="row g-3">
                            <div class="col-6">
                                <div class="p-3 bg-light rounded-3 border">
                                    <div class="display-6 fw-bold text-primary mb-0">100%</div>
                                    <small class="text-muted">Accredited & Online</small>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 bg-light rounded-3 border">
                                    <div class="display-6 fw-bold text-primary mb-0">45+</div>
                                    <small class="text-muted">Global Student Nationalities</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6">
                        <div class="p-4 p-lg-5 bg-light rounded-4 border">
                            <h4 class="fw-bold text-dark mb-3">Why Study With Us?</h4>
                            
                            <div class="d-flex gap-3 mb-4">
                                <div class="text-primary mt-1"><i class="fa fa-globe fa-2x"></i></div>
                                <div>
                                    <h6 class="fw-bold mb-1 text-dark">International Standard Curriculum</h6>
                                    <p class="text-muted small mb-0">Courses designed in English and Indonesian following international academic benchmarks.</p>
                                </div>
                            </div>

                            <div class="d-flex gap-3 mb-4">
                                <div class="text-success mt-1"><i class="fa fa-briefcase fa-2x"></i></div>
                                <div>
                                    <h6 class="fw-bold mb-1 text-dark">Industry Capstone & Mentorship</h6>
                                    <p class="text-muted small mb-0">Hands-on real-world projects mentored by leaders from multinational tech and corporate firms.</p>
                                </div>
                            </div>

                            <div class="d-flex gap-3">
                                <div class="text-warning mt-1"><i class="fa fa-bolt fa-2x"></i></div>
                                <div>
                                    <h6 class="fw-bold mb-1 text-dark">Integrated AI Companion (Demi AI)</h6>
                                    <p class="text-muted small mb-0">Get instant concept clarification, study plans, and automated quiz explanations anytime.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {{! ========================================== }}
        {{! 4. ADMISSIONS & HOW IT WORKS (#admissions) }}
        {{! ========================================== }}
        <section id="admissions" class="py-5 bg-light border-bottom">
            <div class="container py-3">
                <div class="text-center max-w-3xl mx-auto mb-5">
                    <span class="text-primary fw-bold text-uppercase small tracking-wider">Admissions Guide</span>
                    <h2 class="display-6 fw-bold text-dark mb-2">How to Get Started</h2>
                    <p class="lead text-muted">Join World Campus in 3 straightforward steps.</p>
                </div>

                <div class="row g-4 text-center">
                    <div class="col-12 col-md-4">
                        <div class="p-4 bg-white rounded-4 border h-100 shadow-sm">
                            <div class="badge bg-primary rounded-circle p-3 mb-3" style="width: 50px; height: 50px; font-size: 1.2rem;">1</div>
                            <h5 class="fw-bold text-dark mb-2">Select Your Program</h5>
                            <p class="text-muted small mb-0">Choose between S1 Bachelor Degrees, S2 Master Degrees, or short microcredential certificates.</p>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="p-4 bg-white rounded-4 border h-100 shadow-sm">
                            <div class="badge bg-primary rounded-circle p-3 mb-3" style="width: 50px; height: 50px; font-size: 1.2rem;">2</div>
                            <h5 class="fw-bold text-dark mb-2">Apply Online</h5>
                            <p class="text-muted small mb-0">Submit your academic documents and complete the online registration form in under 10 minutes.</p>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="p-4 bg-white rounded-4 border h-100 shadow-sm">
                            <div class="badge bg-primary rounded-circle p-3 mb-3" style="width: 50px; height: 50px; font-size: 1.2rem;">3</div>
                            <h5 class="fw-bold text-dark mb-2">Start Learning</h5>
                            <p class="text-muted small mb-0">Get instant portal access, meet your faculty mentors, and start studying at your own pace.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {{! ========================================== }}
        {{! 5. ENTERPRISE CTA CALLOUT                  }}
        {{! ========================================== }}
        <section class="py-5 bg-gradient-navy text-white">
            <div class="container">
                <div class="row align-items-center gy-4">
                    <div class="col-12 col-lg-8 text-center text-lg-start">
                        <span class="badge bg-danger rounded-pill px-3 py-1 fw-bold mb-2">FOR ORGANIZATIONS & TEAMS</span>
                        <h2 class="display-6 fw-black text-white mb-2">Upskill Your Workforce with World Campus Enterprise</h2>
                        <p class="text-white-50 lead mb-0">Custom corporate learning tracks, employee progress analytics, and accredited certifications for your organization.</p>
                    </div>
                    <div class="col-12 col-lg-4 text-center text-lg-end">
                        <a href="mailto:info@worldcampus.edu" class="btn btn-light text-primary btn-lg rounded-pill fw-bold px-4 shadow">
                            Contact Enterprise Team
                        </a>
                    </div>
                </div>
            </div>
        </section>

        {{! ========================================== }}
        {{! 6. MOODLE STANDARD REGION & BLOCKS         }}
        {{! ========================================== }}
        {{#hasblocks}}
        <section class="py-4 bg-white border-top">
            <div class="container">
                <div id="region-main-box">
                    <section id="region-main" aria-label="{{#str}}content{{/str}}">
                        {{{ output.main_content }}}
                    </section>
                </div>
            </div>
        </section>
        {{/hasblocks}}

    </div>

    {{> theme_worldcampus/footer }}
</div>

{{{ output.standard_after_main_region_html }}}
{{{ output.standard_end_of_body_html }}}
</body>
</html>
